<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SteamWorkshopAgent.BridgeTools</AssemblyName>
    <RootNamespace>SteamWorkshopAgent.BridgeTools</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\artifacts\BridgeTools\SteamWorkshopAgent\</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <!-- RimWorld 1.7 keeps its managed assemblies next to the executable. -->
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld</RimWorldDir>
    <RimWorldManagedDir>$(RimWorldDir)/RimWorld.app/Contents/MacOS</RimWorldManagedDir>
    <RimBridgeAssembliesDir>$(RimWorldDir)/Mods/RimBridgeServer/1.7/Assemblies</RimBridgeAssembliesDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>$(RimWorldManagedDir)/com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RimBridgeAssembliesDir)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RimBridgeServer.Sdk" Version="2.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
